# ===== 飞书应用凭据（必填）=====
# 飞书开放平台 → 你的自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 白名单（必填，留空 = 拒绝所有消息）=====
# 首次可用 FEISHU_BOOTSTRAP=1 启动，在飞书里发消息，桥会回卡片告诉你这两个值
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_ALLOWED_SENDER_OPEN_IDS=

# ===== DSH 侧 =====
DSH_API_BASE=http://127.0.0.1:3080
# 从 ~/.dsh/storages/workspace.json 里取
DSH_FEISHU_WORKSPACE_ID=

# ===== 可选调优 =====
# FEISHU_APPROVAL_POLL_SECONDS=1.5
# 自定义审批目录时，与宿主环境变量 DSH_APPROVAL_PIPE_DIR 保持一致
# FEISHU_APPROVAL_PIPE_DIR=/absolute/path/to/approvals
# DSH_FEISHU_TURN_TIMEOUT=900
# DSH_FEISHU_TURN_HARD_CAP=10800
# DSH_FEISHU_TABLE_MODE=auto
# DSH_FEISHU_TABLE_MAX_NATIVE=5
# DSH_FEISHU_FILE_ROOTS=/home/you/,/tmp/
